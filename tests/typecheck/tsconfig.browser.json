{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": false,
    "noEmit": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../apps/web/src/**/*.ts",
    "../../apps/web/src/**/*.tsx",
    "browser.consumer.tsx",
    "export-sample-peak.consumer.tsx",
    "desktop-launcher.consumer.tsx",
    "timeline-audio-preview.consumer.tsx",
    "export-loudness.consumer.tsx",
    "timeline-mix-loudness.consumer.tsx",
    "timeline-clip-loudness.consumer.tsx",
    "timeline-loudness-apply.consumer.tsx"
  ],
  "exclude": []
}
