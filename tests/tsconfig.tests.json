{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2024.Promise",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "./typecheck/**",
    "./fixtures/workspace-restore-legacy/**",
    "./fixtures/workspace-restore-v27/legacy-contracts/**",
    "./fixtures/local-drafts-v1-contracts.ts",
    "./fixtures/local-drafts-v1-reader.ts",
    "./fixtures/opacity-render-authority-pure.ts",
    "./fixtures/selected-range-http-fixture.ts",
    "./fixtures/timeline-audio-preview/render-oracle.ts",
    "./helpers/agent-edits-qa-support.ts",
    "./helpers/edit-tasks-http-fixture.ts",
    "./helpers/http-file-shutdown-process.ts",
    "./helpers/legacy-workspace-store.ts",
    "./helpers/opacity-inspector-ime-fixture.ts",
    "./helpers/opacity-restored-application-fixture.ts",
    "./helpers/timeline-mix-loudness-ui-fixture.ts",
    "./helpers/timeline-volume-envelope-candidate.ts"
  ]
}
