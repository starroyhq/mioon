{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2024.Promise",
      "ES2024.String",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../apps/web/src/style-modules.d.ts"
  ],
  "exclude": [
    "./helpers/timeline-mix-loudness-ui-fixture.ts",
    "./typecheck/**",
    "./fixtures/local-drafts-v1-contracts.ts",
    "./fixtures/local-drafts-v1-reader.ts"
  ]
}
