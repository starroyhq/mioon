{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2024.Promise",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "./comfy-module-business.test.ts",
    "./export-preflight-http-observer.test.ts",
    "./export-preview-state.test.ts",
    "./fixtures/workspace-restore-legacy/**",
    "./fixtures/workspace-restore-v27/legacy-contracts/**",
    "./helpers/legacy-workspace-store.ts",
    "./helpers/timeline-mix-loudness-ui-fixture.ts",
    "./image-compatible-migration.test.ts",
    "./image-edit-adapter.test.ts",
    "./image-edit-migration.test.ts",
    "./image-edit-network.test.ts",
    "./image-generation-business.test.ts",
    "./image-generation-recovery.test.ts",
    "./image-generation-ui.test.ts",
    "./image-review-business.test.ts",
    "./mcp-v4.test.ts",
    "./typecheck/**",
    "./fixtures/local-drafts-v1-contracts.ts",
    "./fixtures/local-drafts-v1-reader.ts"
  ]
}
