# Server-only configuration template. This file grants no live-generation authority.
# Copy locally to private .env and use node --env-file=.env apps/server/src/cli.mjs.
PORT=4318
WB_DATA_DIR=./data
VIDEO_WORKBENCH_ENABLE_LIVE_PROVIDER=0

RUNWAYML_API_SECRET=
RUNWAY_APPROVED_ASSET_SHA256=
RUNWAY_MAX_GENERATIONS=0
RUNWAY_OUTPUT_HOSTS=

ARK_API_KEY=
ARK_APPROVED_ASSET_SHA256=
ARK_MAX_GENERATIONS=0
ARK_OUTPUT_HOSTS=

GEMINI_API_KEY=
VEO_APPROVED_ASSET_SHA256=
VEO_MAX_GENERATIONS=0
VEO_OUTPUT_HOSTS=

MINIMAX_API_KEY=
MINIMAX_REGION=global
MINIMAX_APPROVED_ASSET_SHA256=
MINIMAX_MAX_GENERATIONS=0
MINIMAX_OUTPUT_HOSTS=

VIDU_API_KEY=
VIDU_REGION=global
VIDU_APPROVED_ASSET_SHA256=
VIDU_MAX_GENERATIONS=0
# Required for Vidu: exact output hosts verified with your regional provider account.
# No wildcard, arbitrary base URL, credential, or guessed CDN belongs here.
VIDU_OUTPUT_HOSTS=

# Region values global|cn select fixed official endpoints; no cross-region fallback.
# Count caps apply conservatively to all local recorded jobs for that provider.
# They are not currency-spend caps; confirm budget and provider-side spending controls.
# Image calls additionally require exact approved SHA-256 hashes, comma-separated.
# Output host lists are optional additional VERIFIED exact CDN hosts except Vidu.
# Do not send this private .env or its values to a browser, agent prompt, or repository.

# Explicit absolute media tools (desktop validates selected executable paths):
# WB_FFMPEG_PATH=/absolute/path/to/ffmpeg
# WB_FFPROBE_PATH=/absolute/path/to/ffprobe
# Desktop channel is selected at build time, not by an environment variable.
# Production userData: app.starroy.mioon; development: app.starroy.mioon.dev.
# WB_DESKTOP_USER_DATA=/absolute/separate/channel-specific/userData
# Agent CLI/MCP configuration, choose one route:
# WB_CONNECTION_FILE=/absolute/path/to/userData/mcp-connection.json
# WB_BASE_URL=http://127.0.0.1:4318
# WB_TOKEN_FILE=/absolute/path/to/data/access-token
