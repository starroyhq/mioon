{
  "name": "mioon",
  "version": "0.4.1",
  "private": true,
  "description": "与 AI 共同创作的视频工作台，本地优先、开源，和 Mio 一起构思、编排镜头与剪辑",
  "license": "Apache-2.0",
  "homepage": "https://mioon.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starroyhq/mioon.git"
  },
  "bugs": {
    "url": "https://github.com/starroyhq/mioon/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "node apps/server/src/cli.ts",
    "start": "node apps/server/src/cli.ts",
    "build": "pnpm --filter @mioon/web build",
    "dev:web": "pnpm --filter @mioon/web dev",
    "mcp": "node apps/mcp/src/index.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "test:browser": "python3 tests/browser_flow.py",
    "test:browser:first-trial": "python3 tests/browser_first_trial.py",
    "demo": "node scripts/demo.ts",
    "doctor": "node scripts/doctor.ts",
    "check:local": "node scripts/tooling.ts doctor",
    "build:local": "node scripts/tooling.ts build",
    "test:local": "node scripts/tooling.ts test",
    "demo:timeline": "python3 scripts/create-timeline-fixtures.py && node scripts/create-timeline-demo.ts",
    "test:timeline": "node --test \"tests/*timeline*.test.ts\"",
    "test:browser:timeline": "python3 tests/browser_timeline.py",
    "desktop:build": "pnpm --filter @mioon/desktop build",
    "desktop": "pnpm --filter @mioon/desktop start",
    "desktop:package:linux": "pnpm --filter @mioon/desktop package:linux",
    "test:desktop": "node --test \"tests/desktop*.test.ts\"",
    "cli": "node apps/cli/src/index.ts",
    "backup": "node apps/cli/src/backup.ts",
    "test:cli": "node --test \"tests/cli*.test.ts\"",
    "test:providers": "node --test \"tests/providers*.test.ts\"",
    "test:browser:providers": "python3 tests/browser_providers_v4.py",
    "desktop:build:production": "pnpm --filter @mioon/desktop build:production",
    "desktop:package:linux:dev": "pnpm --filter @mioon/desktop package:linux:dev",
    "typecheck": "node scripts/tooling.ts typecheck"
  },
  "devDependencies": {
    "@mioon/business": "workspace:*",
    "@mioon/cli": "workspace:*",
    "@mioon/client": "workspace:*",
    "@mioon/contracts": "workspace:*",
    "@mioon/server": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.7",
    "typescript": "6.0.3"
  }
}
