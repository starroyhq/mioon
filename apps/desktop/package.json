{
  "name": "@mioon/desktop",
  "version": "0.3.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Mioon secure Electron desktop host",
  "main": "build/main.cjs",
  "scripts": {
    "build": "node scripts/build.ts",
    "prepare:builder-config": "node scripts/prepare-builder-config.ts",
    "start": "electron build",
    "package:linux": "pnpm run package:linux:dev",
    "package:dir": "pnpm run package:dir:dev",
    "package:mac": "pnpm run package:mac:dev",
    "smoke": "node scripts/smoke.ts",
    "package:linux:dev": "node ../../scripts/tooling.ts build --channel=development && electron-builder --config .generated/electron-builder.dev.cjs --linux --publish never",
    "package:dir:dev": "node ../../scripts/tooling.ts build --channel=development && electron-builder --config .generated/electron-builder.dev.cjs --linux --dir --publish never",
    "package:mac:dev": "node ../../scripts/tooling.ts build --channel=development && electron-builder --config .generated/electron-builder.dev.cjs --mac --publish never",
    "package:win:dev": "pnpm --filter @mioon/node-host build:native && node ../../scripts/tooling.ts build --channel=development && electron-builder --config .generated/electron-builder.dev.cjs --win --publish never"
  },
  "dependencies": {
    "@mioon/contracts": "workspace:*",
    "@mioon/server": "workspace:*",
    "@mioon/business": "workspace:*",
    "electron-updater": "^6.8.9"
  }
}
