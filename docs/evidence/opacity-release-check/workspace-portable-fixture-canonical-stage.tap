           NEW.definition IS NOT OLD.definition OR NEW.createdAt IS NOT OLD.createdAt OR NEW.bytes IS NOT OLD.bytes OR
           (OLD.approval IS NOT NULL AND NEW.approval IS NOT OLD.approval) OR
