        sql: 'CREATE INDEX subject_bindings_active_shot ON subject_bindings(shotId) WHERE subjectVersionId IS NOT NULL'
      109:
        type: 'index'
        name: 'subject_bindings_shot_page'
        tbl_name: 'subject_bindings'
        sql: 'CREATE INDEX subject_bindings_shot_page ON subject_bindings(projectId,shotId,id)'
