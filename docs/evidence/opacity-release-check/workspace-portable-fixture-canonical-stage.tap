    tables:
      agent_chat_events:
        fields:
          0: 'runId'
          1: 'seq'
          2: 'data'
          3: 'bytes'
        rows:
      agent_chat_quota:
        fields:
          0: 'id'
          1: 'runs'
          2: 'bytes'
          3: 'reservedBytes'
        rows:
          0:
            0: '1'
            1: 'integer'
            2: '31'
            3: 'integer'
            4: '30'
            5: 'integer'
            6: '30'
            7: 'integer'
            8: '30'
      agent_chat_requests:
        fields:
          0: 'requestId'
          1: 'projectId'
          2: 'threadId'
